# ══════════════════════════════════════════════════════════
# Synora — Environment Configuration Template
# ══════════════════════════════════════════════════════════
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it contains secrets.
# .env is already in .gitignore.
# ══════════════════════════════════════════════════════════

# ── Flask Server ──────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000

# SECURITY — change to a long random string in production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed browser origins
# Development: http://localhost:5500,http://127.0.0.1:5500
# Production:  https://your-domain.example.com
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ── Database (Phase 2 — PostgreSQL) ───────────────────────
# Development: leave commented out (SQLite used as fallback)
# Production:  uncomment and fill in
# DATABASE_URL=postgresql://synora_user:your_password@localhost:5432/synora_db

# ── Data Directories ──────────────────────────────────────
# Base directory for all server-generated data files
# Development: relative path is fine
# Production:  use absolute path e.g. /var/lib/synora/data
DATA_DIR=data

# ── Session Tokens ────────────────────────────────────────
SESSION_TOKEN_TTL_HOURS=24

# ── Federated Learning Defaults ───────────────────────────
# These can be overridden per-experiment via API
DEFAULT_MIN_CLIENTS=2
DEFAULT_MAX_ROUNDS=10
DEFAULT_SELECTION_COUNT=2
