# ══════════════════════════════════════════════════════════
# Synora — Environment Configuration Template
# ══════════════════════════════════════════════════════════
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it contains secrets.
# .env is already in .gitignore.
# ══════════════════════════════════════════════════════════

# ── Flask Server ──────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000

# SECURITY — change to a long random string in production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed browser origins (variable name: ALLOWED_ORIGINS)
# Development: * (any)  -> the Next.js dev server on http://localhost:3000 works
# Production:  https://your-app.vercel.app
ALLOWED_ORIGINS=*

# Optional: enables the maintenance endpoints DELETE /experiment/reset and
# DELETE /clients/reset (send the same value in the X-Admin-Key header).
# ADMIN_KEY=choose-a-long-random-value

# ── Database (Phase 2 — PostgreSQL) ───────────────────────
# LOCAL TESTING (recommended before deploying - touches NO real data):
DATABASE_URL=sqlite:///local_test.db
# PRODUCTION (Supabase) - set this in the Render dashboard, never commit it:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres

# ── Data Directories ──────────────────────────────────────
# Base directory for all server-generated data files
# Development: relative path is fine
# Production:  use absolute path e.g. /var/lib/synora/data
DATA_DIR=data

# ── Session Tokens ────────────────────────────────────────
SESSION_TOKEN_TTL_HOURS=24

# ── Federated Learning Defaults ───────────────────────────
# These can be overridden per-experiment via API
DEFAULT_MIN_CLIENTS=2
DEFAULT_MAX_ROUNDS=10
DEFAULT_SELECTION_COUNT=2
